# Copy to .env.local. Restart `npm run dev` after changes.

# Base URL of the NestJS backend API (auth, QA, Figma). Cookies flow with credentials.
NEXT_PUBLIC_API_URL=http://localhost:4300/api

# Public base URL of this site (used for absolute SEO/OG URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:4200
