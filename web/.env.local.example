# Copy to .env.local. Restart `npm run dev` after changes.

# Browser API base. RELATIVE by default so requests are same-origin and Next
# proxies /api/* to the backend (see next.config.mjs rewrites). This keeps auth
# cookies first-party and lets the app work behind a tunnel (ngrok) without CORS.
NEXT_PUBLIC_API_URL=/api
# Backend origin, used SERVER-SIDE only: SSR fetches + the /api proxy target.
API_INTERNAL_URL=http://localhost:4300/api

# Public base URL of this site (used for absolute SEO/OG URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:4200
