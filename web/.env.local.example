# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- Figma "Login with Figma" OAuth (owner sets up once) ---
# Create a Figma app at https://www.figma.com/developers  → My apps → Create app.
# Add redirect/callback URL: http://localhost:4200/api/auth/callback  (and your prod URL)
# Enable scope: file_content:read
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=http://localhost:4200/api/auth/callback

# Secret used to encrypt the session cookie holding the user's Figma token.
# Use a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Where the QA pipeline backend (Playwright + Figma + report) is reachable.
QA_BACKEND_URL=http://127.0.0.1:4100

# Public base URL of this site (used for absolute SEO/OG URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:4200
