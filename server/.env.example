# Copy to .env. Never commit the real .env.

# Server
PORT=4300
NODE_ENV=development
# Comma-separated allowed origins for CORS (the Next frontend).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Public URL of the frontend (used in verify/reset email links + OAuth redirects).
APP_BASE_URL=http://localhost:4200

# Database (Phase B)
# Local dev default = SQLite (zero setup). For Postgres (e.g. Neon), set the
# schema.prisma provider to "postgresql" and use a postgres URL instead.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth (Phase C)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Admin panel — comma-separated emails that are auto-promoted to ADMIN on
# login/signup. These accounts can access /admin (users, stats, management).
ADMIN_EMAILS=

# Google OAuth (Phase C) — from Google Cloud console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback

# Figma — per-user only. Each user connects their OWN Figma (OAuth one-click, or
# they paste a personal access token). There is deliberately NO server-wide
# Figma token: a user's credential is never used for anyone else's run.
# These OAuth keys (from an owner-registered Figma app) only enable the
# one-click "Connect with Figma" button; the PAT path needs no server config.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=http://localhost:4300/api/figma/callback

# Anthropic vision is BRING-YOUR-OWN: each user adds their own API key in the
# app (encrypted at rest). There is no shared/platform key used for user runs.

# Email (Phase C) — Mailpit dev mailer by default
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KODERLABS Design QA <no-reply@koderlabs.local>"

# Encryption key for stored third-party tokens (Figma) — 32+ random chars
TOKEN_ENC_SECRET=change-me-token-encryption
API_PUBLIC_URL=http://localhost:4300/api

# Allow loopback/private QA targets — true for local dev, FALSE/ignored in
# production (SSRF; link-local + cloud-metadata are always blocked).
# Legacy alias QA_ALLOW_PRIVATE_TARGETS is still honored.
ALLOW_LOCAL_TARGETS=true

# QA worker (in-process). Runs are heavy (headless browser + optional vision).
QA_MAX_CONCURRENT=2            # global cap on simultaneous runs
QA_MAX_CONCURRENT_PER_USER=1   # per-user cap (others queue)
QA_JOB_TIMEOUT_MS=300000       # hard wall-clock timeout per run (5 min)
# QA_OUTPUT_DIR=./qa-output    # where per-job reports/artifacts are written

# Storage for avatars + report artifacts.
#   local (default) — the instance filesystem. Fine for a single instance.
#   s3              — object storage; REQUIRED once you run more than one
#                     instance (local disk isn't shared between them).
STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=./qa-output   # local driver root (defaults to QA_OUTPUT_DIR)
# --- s3 driver (STORAGE_DRIVER=s3) ---
# S3_BUCKET=my-design-qa-artifacts
# S3_REGION=us-east-1
# S3_ENDPOINT=                     # set for S3-compatible stores (MinIO/R2)
# S3_PREFIX=                       # optional key namespace within the bucket
# S3_URL_TTL=300                   # presigned download URL lifetime (seconds)
# AWS credentials come from the standard provider chain (env / IAM role / profile):
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=
