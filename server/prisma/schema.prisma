// Pixparity — data model.
// Local dev uses SQLite (a single file, zero setup). Status/type fields are
// plain strings and JSON is stored as text, so this same schema also works on
// Postgres later — switch `provider` to "postgresql" and set DATABASE_URL.
//
// Status values (QAJob.status): PENDING | RUNNING | COMPLETED | FAILED
// Token types (VerificationToken.type): EMAIL_VERIFICATION | PASSWORD_RESET

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // null for Google-only accounts
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  avatarUrl     String?
  role          String    @default("USER") // USER | ADMIN
  disabledAt    DateTime? // set => account is disabled (cannot log in)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  credentials        ApiCredential[]
  qaJobs             QAJob[]

  @@index([email])
}

// Hashed refresh tokens for JWT rotation + revocation.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
}

// Email verification + password reset tokens (single-use, hashed).
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // EMAIL_VERIFICATION | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// A user's per-provider API credential (Figma / Anthropic), encrypted at rest.
// One row per (user, provider). `secretEnc` is the access token / api key;
// `refreshTokenEnc`/`expiresAt` apply to Figma OAuth. Never returned to clients.
model ApiCredential {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // 'figma' | 'anthropic'
  type            String // 'oauth' | 'pat'
  secretEnc       String
  refreshTokenEnc String?
  expiresAt       DateTime?
  accountLabel    String? // e.g. Figma user id, or "Personal token"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model QAJob {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  figmaUrl   String
  targetUrl  String
  vision     Boolean   @default(true)
  pdf        Boolean   @default(true)
  viewport   Int? // null = auto
  status     String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  progress   String? // last streamed stage/message (persisted for reconnects)
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  report QAReport?

  @@index([userId, createdAt])
}

// A person shown on the public "Our Team" page (/team). Editable by admins
// via /api/admin/team; the public page reads the visible rows from /api/team.
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  avatarUrl   String? // optional photo; falls back to gradient + initials
  linkedinUrl String?
  xUrl        String?
  sortOrder   Int      @default(0) // ascending display order on the page
  visible     Boolean  @default(true) // hide without deleting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model QAReport {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             QAJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  frameName       String?
  viewport        Int?
  pointersChecked Int      @default(0)
  passed          Int      @default(0)
  failed          Int      @default(0)
  matched         Int      @default(0)
  // JSON stored as text (portable across SQLite/Postgres).
  issuesBySeverity String?
  // Denormalized per-severity issue counts (derived from issuesBySeverity on
  // write) so the dashboards SUM() them DB-side instead of loading + parsing
  // every report row. Keep in sync with the JSON blob above.
  sevCritical      Int      @default(0)
  sevHigh          Int      @default(0)
  sevMedium        Int      @default(0)
  sevLow           Int      @default(0)
  sevInfo          Int      @default(0)
  summary          String?
  htmlPath         String?
  jsonPath         String?
  pdfPath          String?
  createdAt        DateTime @default(now())
}
